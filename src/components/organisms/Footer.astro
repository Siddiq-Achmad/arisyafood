---
import Icon from "../atoms/Icon.astro";

const quickLinks = [
  { name: "About Us", href: "/about" },
  { name: "Certifications & Legality", href: "/legality" },
  { name: "Production Gallery", href: "/gallery" },
  { name: "Contact & Export", href: "/contact" },
];

const productLinks = [
  { name: "Raw Crackers", href: "/products#crackers" },
  { name: "Vegetarian Food", href: "/products#vegetarian" },
  { name: "Indonesian Spices", href: "/products#spices" },
  { name: "Global Markets", href: "/#reach" },
];
---

<footer class="bg-primary text-on-primary py-section-gap-desktop w-full">
  <div
    class="max-w-container-max mx-auto px-grid-gutter grid grid-cols-1 md:grid-cols-4 gap-grid-gutter"
  >
    <!-- Company Overview -->
    <div class="col-span-1 md:col-span-1">
      <div class="flex items-center gap-3 mb-8">
        <img
          fetchpriority="high"
          decoding="sync"
          alt="Arisyafood Logo"
          class="h-16 w-auto brightness-0 invert"
          width="230"
          height="153"
          src="/logo.png"
        />
        <div class="flex flex-col leading-none">
          <span
            class="text-2xl font-display font-semibold text-white tracking-tight"
            >ARISYA</span
          >
          <span
            class="text-[12px] font-label text-secondary tracking-wide uppercase"
            >Global Niaga</span
          >
        </div>
      </div>
      <p class="text-body-md opacity-70 mb-8 leading-relaxed font-light">
        Your trusted export partner for premium Indonesian food products.
        Delivering excellence from local sources to global markets.
      </p>
      <div class="flex gap-4">
        <a
          class="w-10 h-10 rounded bg-white/10 flex items-center justify-center hover:bg-secondary transition-all"
          href="mailto:sales@arisyaglobal.com"
          aria-label="Email Us"
        >
          <Icon name="mail" size="text-[20px]" />
        </a>
        <a
          class="w-10 h-10 rounded bg-white/10 flex items-center justify-center hover:bg-secondary transition-all"
          href="tel:+6285121310331"
          aria-label="Call Us"
        >
          <Icon name="phone" size="text-[20px]" />
        </a>
        <a
          class="w-10 h-10 rounded bg-white/10 flex items-center justify-center hover:bg-secondary transition-all"
          href="https://wa.me/6285121310331"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
        >
          <svg
            class="w-5 h-5 fill-current"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
            ></path></svg
          >
        </a>
        <a
          class="w-10 h-10 rounded bg-white/10 flex items-center justify-center hover:bg-secondary transition-all"
          href="https://linkedin.com/company/arisyafood"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
        >
          <svg
            class="w-5 h-5 fill-current"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path></svg
          >
        </a>
        <a
          class="w-10 h-10 rounded bg-white/10 flex items-center justify-center hover:bg-secondary transition-all"
          href="https://www.instagram.com/arisyafood"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram Profile"
        >
          <svg
            class="w-5 h-5 fill-current"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
            ></path></svg
          >
        </a>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h4 class="text-headline-md font-bold mb-8 text-secondary-fixed">
        Quick Links
      </h4>
      <ul class="space-y-4 text-body-md">
        {
          quickLinks.map((link) => (
            <li>
              <a
                class="opacity-80 hover:opacity-100 hover:translate-x-1 inline-block transition-all"
                href={link.href}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Products -->
    <div>
      <h4 class="text-headline-md font-bold mb-8 text-secondary-fixed">
        Products
      </h4>
      <ul class="space-y-4 text-body-md">
        {
          productLinks.map((link) => (
            <li>
              <a
                class="opacity-80 hover:opacity-100 hover:translate-x-1 inline-block transition-all"
                href={link.href}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact Info -->
    <div>
      <h4 class="text-headline-md font-bold mb-8 text-secondary-fixed">
        Contact Info
      </h4>
      <ul class="space-y-4 text-body-md opacity-80">
        <li class="flex gap-3 items-start">
          <Icon
            name="location_on"
            class="text-secondary mt-0.5"
            size="text-[20px]"
          />
          <span>Medan, North Sumatra, Indonesia</span>
        </li>
        <li class="flex gap-3 items-center">
          <Icon name="call" class="text-secondary" size="text-[20px]" />
          <span> (+62) 851 2131 0331</span>
        </li>
        <li class="flex gap-3 items-center">
          <Icon name="mail" class="text-secondary" size="text-[20px]" />
          <span>sales@arisyaglobal.com</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="max-w-container-max mx-auto px-grid-gutter border-t border-white/10 mt-20 pt-10 flex flex-col md:flex-row justify-between items-center gap-4"
  >
    <p class="text-label-md opacity-50">
      © {new Date().getFullYear()} PT ARISYAFOOD GLOBAL NIAGA. All Rights Reserved.
    </p>
    <div class="flex gap-8 text-label-md opacity-50">
      <a class="hover:opacity-100 transition-opacity" href="/privacy"
        >Privacy Policy</a
      >
      <a class="hover:opacity-100 transition-opacity" href="/terms"
        >Terms & Conditions</a
      >
      <a class="hover:opacity-100 transition-opacity" href="/cookies"
        >Cookie Policy</a
      >
    </div>
  </div>
</footer>
