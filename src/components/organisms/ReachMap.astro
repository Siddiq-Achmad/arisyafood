---
import ReachItem from "../molecules/ReachItem.astro";
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";

const markets = [
  { country: "Southeast Asia", region: "High Cultural Familiarity" },
  { country: "Middle East", region: "100% Halal Requirement" },
  { country: "Australia & NZ", region: "Strong Diaspora Demand" },
  { country: "East Asia", region: "Premium Quality Market" },
  { country: "Europe", region: "Growing Vegan Market" },
];
---

<section
  class="py-section-gap-desktop bg-primary text-on-primary overflow-hidden parallax-wrapper w-full"
  id="reach"
>
  <!-- Parallax Background Element -->
  <div class="parallax-bg bg-primary/95" id="reach-parallax"></div>

  <div class="max-w-container-max mx-auto px-grid-gutter relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Copy and Statistics -->
      <div class="reveal">
        <h2 class="font-display text-display-lg text-2xl md:text-3xl mb-8">
          Empowering Global Trade through Quality
        </h2>
        <p class="text-body-lg text-primary-fixed mb-12">
          With a strategic base in Indonesia, we successfully serve partners
          across Asia, Europe, and the Middle East. Our logistics chain is
          optimized for freshness and punctuality.
        </p>

        <!-- Grid of ReachItem Molecules -->
        <div class="grid grid-cols-2 gap-8 mb-12">
          {
            markets.map((market) => (
              <ReachItem country={market.country} region={market.region} />
            ))
          }
        </div>

        <Button
          href="/assets/Company Profile.pdf"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          class="flex items-center gap-2 px-8 py-4"
        >
          Download Company Profile
          <Icon name="download" size="text-[18px]" />
        </Button>
      </div>

      <!-- Interactive Animated Map Vector -->
      <div class="relative reveal delay-200">
        <div
          class="bg-primary-container/30 rounded-2xl px-4 py-8 relative border border-outline/20"
        >
          <div
            class="w-full aspect-[16/9] bg-[url('/images/world.svg')] bg-contain bg-no-repeat bg-center opacity-20 filter invert pb-4"
          >
          </div>
          <!-- Indonesia (Base) -->
          <div
            class="absolute top-[47%] left-[75%] w-4 h-4 bg-secondary rounded-full ring-4 ring-secondary/40"
          >
          </div>

          <!-- Southeast Asia -->
          <div
            class="absolute top-[42%] left-[73%] w-3 h-3 bg-secondary rounded-full animate-ping delay-100"
          >
          </div>

          <!-- East Asia -->
          <div
            class="absolute top-[20%] left-[80%] w-3 h-3 bg-secondary rounded-full animate-ping delay-300"
          >
          </div>

          <!-- Middle East -->
          <div
            class="absolute top-[27%] left-[59%] w-3 h-3 bg-secondary rounded-full animate-ping delay-500"
          >
          </div>

          <!-- Europe -->
          <div
            class="absolute top-[12%] left-[47%] w-3 h-3 bg-secondary rounded-full animate-ping delay-700"
          >
          </div>

          <!-- Australia & NZ -->
          <div
            class="absolute top-[62%] left-[82%] w-3 h-3 bg-secondary rounded-full animate-ping delay-1000"
          >
          </div>

          <p class="text-center mt-8 text-label-md opacity-60">
            Medan, Indonesia Hub & Export Routes
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
