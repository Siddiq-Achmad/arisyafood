---
interface Props {
  country: string;
  region: string;
  class?: string;
}

const { country, region, class: className = "" } = Astro.props;
---

<div class={`border-l-2 border-secondary pl-6 ${className}`}>
  <h4 class="text-headline-md font-bold text-secondary-fixed mb-1">
    {country}
  </h4>
  <p class="text-label-md opacity-80">
    {region}
  </p>
</div>
