---
import MainLayout from "../components/templates/MainLayout.astro";
import Button from "../components/atoms/Button.astro";
import Badge from "../components/atoms/Badge.astro";
import Icon from "../components/atoms/Icon.astro";
import ProductCarousel from "../components/organisms/ProductCarousel.astro";
import ReachMap from "../components/organisms/ReachMap.astro";
import CertificationBar from "../components/organisms/CertificationBar.astro";

// B2B Featured categories on homepage
const categories = [
  {
    title: "Indonesian Spices",
    description:
      "Premium quality white pepper, black pepper, coriander, and cloves, sourced directly from best plantations.",
    image: "/images/products/Spices/spices_category.png",
    href: "/products#spices",
  },
  {
    title: "Raw Crackers",
    description:
      "Authentic Indonesian crackers with various flavors including Prawn, Fish, and Onion, ready for export.",
    image: "/images/products/Kerupuk/raw_crackers_category.png",
    href: "/products#crackers",
  },
  {
    title: "Vegetarian Food",
    description:
      "Healthy plant-based instant noodles and roasted peanuts made from natural Indonesian sources with modern process.",
    image: "/images/products/Vegetarian/vegetarian_noodle_category.png",
    href: "/products#vegetarian",
  },
];
// FAQ Schema for AEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What products does PT Arisyafood Global Niaga export?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We export authentic Indonesian products including Raw Crackers (Kerupuk), Vegetarian Snacks, and Indonesian Powdered Spices.",
      },
    },
    {
      "@type": "Question",
      name: "Are Arisyafood products Halal certified?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, our products are Halal MUI Certified and BPOM Registered to ensure full compliance with international food safety standards.",
      },
    },
    {
      "@type": "Question",
      name: "Which countries do you export to?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We export to 8+ major markets globally including Southeast Asia, the Middle East, East Asia, Europe, and Australia & NZ.",
      },
    },
  ],
};
---

<MainLayout
  title="PT Arisyafood Global Niaga | Premium Indonesian Export Company"
  schemaData={[faqSchema]}
>
  <!-- Grand Hero Section -->
  <section
    class="relative min-h-screen flex flex-col justify-center overflow-hidden parallax-wrapper w-full"
  >
    <!-- Parallax Hero Background -->
    <div class="parallax-bg bg-mesh" id="hero-parallax"></div>

    <div
      class="max-w-container-max mx-auto px-grid-gutter pt-section-gap-mobile lg:pt-0 relative z-10 w-full"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center pt-12">
        <!-- Left Hero Column -->
        <div class="reveal active">
          <Badge variant="primary-fixed">Established in Indonesia</Badge>

          <h1
            class="font-display text-display-lg text-primary mb-6 leading-tight"
          >
            Authentic Indonesian Taste For <span class="text-secondary"
              >Global Markets</span
            >
          </h1>

          <p class="text-body-lg text-on-surface-variant mb-10 max-w-xl">
            PT ARISYAFOOD GLOBAL NIAGA delivers premium Spices, Raw Crackers,
            and Vegetarian Food with consistent quality, competitive pricing,
            and professional logistics to the global market.
          </p>

          <div class="flex flex-wrap gap-4 font-label">
            <Button
              href="/products"
              variant="primary"
              class="px-8 py-4 shadow-xl hover:shadow-2xl"
              aria-label="Explore our product catalog"
            >
              Explore Catalog
            </Button>
            <Button
              href="/contact"
              variant="outline"
              class="px-8 py-4 bg-surface text-primary border-primary hover:bg-primary-container"
              aria-label="Contact our sales team"
            >
              Contact Sales
            </Button>
          </div>

          <!-- Trust Stats Row -->
          <div
            class="mt-12 flex gap-8 items-center border-t border-outline-variant pt-8"
          >
            <div>
              <p class="text-headline-md font-bold text-primary">30+</p>
              <p class="text-label-md text-on-surface-variant">Countries</p>
            </div>
            <div class="w-px h-10 bg-outline-variant"></div>
            <div>
              <p class="text-headline-md font-bold text-primary">100%</p>
              <p class="text-label-md text-on-surface-variant">
                Quality Control
              </p>
            </div>
            <div class="w-px h-10 bg-outline-variant"></div>
            <div>
              <p class="text-headline-md font-bold text-primary">Trusted</p>
              <p class="text-label-md text-on-surface-variant">Certified</p>
            </div>
          </div>
        </div>

        <!-- Right Hero Column -->
        <div class="relative reveal active delay-200">
          <div
            class="aspect-square rounded-full bg-secondary-container/20 absolute -z-10 blur-3xl -right-20 -top-20 w-[120%]"
          >
          </div>

          <img
            fetchpriority="high"
            decoding="sync"
            class="w-full h-auto object-cover rounded-xl shadow-2xl"
            alt="A premium, high-resolution lifestyle photograph showcasing a variety of traditional Indonesian spices and raw crackers arranged elegantly on a clean white surface."
            src="/images/products/hero_spices_crackers.png"
          />

          <!-- Floating Safe Food Certification Badge -->
          <div
            class="absolute -bottom-6 -left-6 bg-white p-6 rounded-lg shadow-xl hidden md:block border border-outline-variant"
          >
            <div class="flex items-center gap-4">
              <Icon
                name="verified"
                class="text-secondary text-[40px]"
                fill={true}
              />
              <div>
                <p class="text-headline-md font-bold text-primary">
                  Export Lic.
                </p>
                <p class="text-label-md text-on-surface-variant">
                  Official Permit
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Best Selling Products Carousel Organism -->
      <ProductCarousel />
    </div>
  </section>

  <!-- About Us Teaser -->
  <section
    class="py-section-gap-desktop bg-surface-container-lowest relative overflow-hidden"
    id="about"
  >
    <div class="max-w-container-max mx-auto px-grid-gutter relative z-10">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-grid-gutter items-center"
      >
        <!-- Left Image Section -->
        <div
          class="lg:col-span-5 reveal flex items-center justify-center p-8 bg-surface-container rounded-2xl"
        >
          <img
            loading="lazy"
            decoding="async"
            class="w-full max-w-sm h-auto object-contain drop-shadow-md hover:scale-105 transition-transform duration-500"
            alt="PT Arisyafood Global Niaga Logo"
            src="/images/logo.png"
          />
        </div>

        <!-- Right Info Column -->
        <div class="lg:col-span-7">
          <div class="pl-0 lg:pl-12 mt-8 lg:mt-0">
            <h2 class="text-headline-lg font-semibold text-primary mb-6 reveal">
              Your Trusted Export Partner for Authentic Indonesian Products
            </h2>
            <p
              class="text-body-lg text-on-surface-variant mb-8 reveal delay-100 leading-relaxed"
            >
              <strong>PT Arisyafood Global Niaga</strong> is an export trading company
              based in Medan, Indonesia. We specialize in bringing the finest Indonesian
              agricultural products—including premium spices, raw crackers, and vegetarian
              snacks—to the global market with uncompromising quality.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal delay-200">
              <div class="flex items-start gap-4">
                <Icon name="visibility" class="text-secondary mt-1" />
                <div>
                  <h4 class="text-headline-md font-semibold text-primary mb-2">
                    Our Vision
                  </h4>
                  <p
                    class="text-body-md text-on-surface-variant leading-relaxed"
                  >
                    To be Indonesia's most trusted export partner, recognized
                    globally for quality, consistency, and the richness of
                    Indonesian culinary heritage.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Icon name="verified" class="text-secondary mt-1" />
                <div>
                  <h4 class="text-headline-md font-semibold text-primary mb-2">
                    Quality Assured
                  </h4>
                  <p
                    class="text-body-md text-on-surface-variant leading-relaxed"
                  >
                    Zero compromise on product quality. We ensure all our
                    products meet strict international certification standards
                    and food safety compliance.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Categories Grid -->
  <section class="py-section-gap-desktop bg-surface" id="products">
    <div class="max-w-container-max mx-auto px-grid-gutter text-center mb-16">
      <span
        class="text-secondary text-label-md font-semibold tracking-widest uppercase reveal"
        >Our Core Portfolio</span
      >
      <h2
        class="font-display text-display-lg text-primary mt-2 reveal delay-100"
      >
        Export Product Categories
      </h2>
      <div class="w-24 h-1 bg-secondary mx-auto mt-6 reveal delay-200"></div>
    </div>

    <div
      class="max-w-container-max mx-auto px-grid-gutter grid grid-cols-1 md:grid-cols-3 gap-8"
    >
      {
        categories.map((cat, index) => (
          <div
            class="group reveal"
            style={`transition-delay: ${index * 100}ms;`}
          >
            <div class="relative overflow-hidden rounded-xl bg-white border border-outline-variant hover:border-secondary hover:shadow-lg transition-all h-full flex flex-col">
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  src={cat.image}
                  alt={cat.title}
                />
              </div>
              <div class="p-8 flex-grow flex flex-col justify-between">
                <div>
                  <h3 class="text-headline-lg font-semibold text-primary mb-4">
                    {cat.title}
                  </h3>
                  <p class="text-body-md text-on-surface-variant mb-6 leading-relaxed">
                    {cat.description}
                  </p>
                </div>
                <a
                  class="inline-flex items-center gap-2 text-secondary font-semibold hover:gap-4 transition-all"
                  href={cat.href}
                >
                  VIEW DETAILS
                  <Icon name="arrow_right_alt" />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Global Export Reach Organism -->
  <ReachMap />

  <!-- Trust & Certification Banner Organism -->
  <CertificationBar />
</MainLayout>
