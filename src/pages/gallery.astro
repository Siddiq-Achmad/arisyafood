---
import MainLayout from '../components/templates/MainLayout.astro';
import Badge from '../components/atoms/Badge.astro';
import Icon from '../components/atoms/Icon.astro';
import Button from '../components/atoms/Button.astro';
---

<MainLayout 
  title="Gallery & Legality | PT ARISYAFOOD GLOBAL NIAGA" 
  description="Explore our advanced production facilities, global logistics hubs, and international food safety accreditations."
>
  <!-- Hero Section -->
  <section class="relative h-[614px] flex items-center overflow-hidden w-full">
    <div class="absolute inset-0 z-0">
      <img fetchpriority="high" decoding="sync" 
        alt="A high-angle cinematic shot of a clean food processing facility"
        class="w-full h-[120%] object-cover absolute -top-[10%] parallax-bg brightness-50"
        id="hero-parallax"
        src="/images/gallery/production_activity.png" 
      />
    </div>
    <div class="relative z-10 max-w-container-max mx-auto px-grid-gutter w-full">
      <div class="max-w-2xl reveal active">
        <h1 class="text-5xl font-bold text-white mb-6 leading-tight">
          Gallery Activity
        </h1>
        <p class="text-lg text-surface-variant mb-8 opacity-90">
          Witness our commitment to excellence across every B2B operational step—from organic sourcing and state-of-the-art production to secure warehousing and global port logistics.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery Section (Bento Grid) -->
  <section class="py-section-gap-desktop bg-surface-container-lowest" id="gallery">
    <div class="max-w-container-max mx-auto px-grid-gutter">
      <div class="text-center mb-16 reveal">
        <span class="text-secondary text-sm font-bold tracking-widest uppercase block mb-3">Visual Journey</span>
        <h2 class="text-4xl font-bold text-primary">Operational Highlights</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:h-[1000px]">
        <!-- Large Feature: Production Activity -->
        <div class="md:col-span-8 md:row-span-2 relative group overflow-hidden rounded-xl bg-surface-container reveal stagger-1 h-[400px] md:h-auto">
          <img loading="lazy" decoding="async" 
            alt="State-of-the-art automated food production and hygienic processing facility"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src="/images/gallery/production_activity.png" 
          />
          <div class="absolute inset-0 gallery-overlay flex flex-col justify-end p-8">
            <span class="text-secondary-fixed text-xs font-bold mb-2 uppercase tracking-wider">Production</span>
            <h3 class="text-white text-2xl font-bold font-headline">Production Activity</h3>
          </div>
        </div>

        <!-- Side Top: Port -->
        <div class="md:col-span-4 relative group overflow-hidden rounded-xl bg-surface-container reveal stagger-2 h-[250px] md:h-auto">
          <img loading="lazy" decoding="async" 
            alt="Modern busy Indonesian shipping port harbor and cargo logistics"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src="/images/gallery/export_port.png" 
          />
          <div class="absolute inset-0 gallery-overlay flex flex-col justify-end p-6">
            <span class="text-secondary-fixed text-xs font-bold mb-2 uppercase tracking-wider">Port</span>
            <h3 class="text-white text-xl font-bold font-headline">Port Operations</h3>
          </div>
        </div>

        <!-- Side Bottom: Warehouse -->
        <div class="md:col-span-4 relative group overflow-hidden rounded-xl bg-surface-container reveal stagger-3 h-[250px] md:h-auto">
          <img loading="lazy" decoding="async" 
            alt="Sleek modern B2B logistics food warehouse and high metal storage racks"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src="/images/gallery/our_warehouse.png" 
          />
          <div class="absolute inset-0 gallery-overlay flex flex-col justify-end p-6">
            <span class="text-secondary-fixed text-xs font-bold mb-2 uppercase tracking-wider">Warehouse</span>
            <h3 class="text-white text-xl font-bold font-headline">Our Warehouse</h3>
          </div>
        </div>

        <!-- Bottom Wide: Material Product -->
        <div class="md:col-span-6 relative group overflow-hidden rounded-xl bg-surface-container reveal stagger-1 h-[250px] md:h-auto">
          <img loading="lazy" decoding="async" 
            alt="Premium raw cassava crackers and traditional Indonesian spices on textured background"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src="/images/gallery/material_product.png" 
          />
          <div class="absolute inset-0 gallery-overlay flex flex-col justify-end p-6">
            <span class="text-secondary-fixed text-xs font-bold mb-2 uppercase tracking-wider">Material Product</span>
            <h3 class="text-white text-xl font-bold font-headline">Material Product</h3>
          </div>
        </div>

        <!-- Bottom Small: Our Supplier -->
        <div class="md:col-span-6 relative group overflow-hidden rounded-xl bg-surface-container reveal stagger-2 h-[250px] md:h-auto">
          <img loading="lazy" decoding="async" 
            alt="Indonesian local farmers harvesting fresh organic agricultural crops"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src="/images/gallery/our_supplier.png" 
          />
          <div class="absolute inset-0 gallery-overlay flex flex-col justify-end p-6">
            <span class="text-secondary-fixed text-xs font-bold mb-2 uppercase tracking-wider">Our Supplier</span>
            <h3 class="text-white text-xl font-bold font-headline">Our Supplier Network</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Legality & Certifications Section -->
  <section class="py-section-gap-desktop bg-surface relative overflow-hidden" id="legality">
    <!-- Decorative Parallax Element -->
    <div 
      class="absolute top-20 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl parallax-bg pointer-events-none"
      id="decor-bubble"
    ></div>
    
    <div class="max-w-container-max mx-auto px-grid-gutter relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 reveal">
        <div class="max-w-2xl">
          <span class="text-secondary text-sm font-bold tracking-widest uppercase block mb-3">Compliance &amp; Trust</span>
          <h2 class="text-4xl font-bold text-primary">Certified for Global Standards</h2>
          <p class="text-base text-on-surface-variant mt-4 leading-relaxed">
            We maintain strict adherence to international safety protocols and local Indonesian regulations to provide peace of mind for our international business partners.
          </p>
        </div>
        <div class="mt-8 md:mt-0">
          <div class="flex gap-4">
            <button class="p-3 border border-outline-variant rounded-full hover:bg-primary hover:text-white transition-all duration-200" aria-label="Download Certifications">
              <Icon name="download" />
            </button>
            <button class="p-3 border border-outline-variant rounded-full hover:bg-primary hover:text-white transition-all duration-200" aria-label="Share Certifications">
              <Icon name="share" />
            </button>
          </div>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-grid-gutter">
        <!-- Certification Card 1 -->
        <div class="certification-card p-8 bg-white border border-outline-variant rounded-xl reveal stagger-1 shadow-sm group">
          <div class="flex justify-between items-start mb-6">
            <div class="w-16 h-16 bg-surface-container flex items-center justify-center rounded-lg cert-icon">
              <Icon name="verified_user" size="text-4xl" class="text-primary group-hover:text-secondary transition-colors" fill={true} />
            </div>
            <Badge variant="primary-fixed" class="mb-0">Active</Badge>
          </div>
          <h3 class="text-xl font-bold text-primary mb-2">Halal Certificate</h3>
          <p class="text-sm text-on-surface-variant mb-6 leading-relaxed">
            Issued by BPJPH Indonesia, ensuring all products comply with Sharia requirements for global distribution.
          </p>
          <div class="flex items-center text-primary font-bold text-sm hover:underline cursor-pointer">
            View Credentials <Icon name="open_in_new" size="text-sm" class="ml-2" />
          </div>
        </div>

        <!-- Certification Card 2 -->
        <div class="certification-card p-8 bg-white border border-outline-variant rounded-xl reveal stagger-2 shadow-sm group">
          <div class="flex justify-between items-start mb-6">
            <div class="w-16 h-16 bg-surface-container flex items-center justify-center rounded-lg cert-icon">
              <Icon name="health_and_safety" size="text-4xl" class="text-primary group-hover:text-secondary transition-colors" fill={true} />
            </div>
            <Badge variant="primary-fixed" class="mb-0">Certified</Badge>
          </div>
          <h3 class="text-xl font-bold text-primary mb-2">AR-E &amp; BPOM Registered</h3>
          <p class="text-sm text-on-surface-variant mb-6 leading-relaxed">
            Fully registered under BPOM (Indonesian FDA) and AR-E certification, guaranteeing food safety compliance and smooth international customs clearance.
          </p>
          <div class="flex items-center text-primary font-bold text-sm hover:underline cursor-pointer">
            View Credentials <Icon name="open_in_new" size="text-sm" class="ml-2" />
          </div>
        </div>

        <!-- Certification Card 3 -->
        <div class="certification-card p-8 bg-white border border-outline-variant rounded-xl reveal stagger-3 shadow-sm group">
          <div class="flex justify-between items-start mb-6">
            <div class="w-16 h-16 bg-surface-container flex items-center justify-center rounded-lg cert-icon">
              <Icon name="business_center" size="text-4xl" class="text-primary group-hover:text-secondary transition-colors" fill={true} />
            </div>
            <Badge variant="primary-fixed" class="mb-0">Verified</Badge>
          </div>
          <h3 class="text-xl font-bold text-primary mb-2">Business License (NIB)</h3>
          <p class="text-sm text-on-surface-variant mb-6 leading-relaxed">
            Official Single Business Identification Number (NIB) and SIUP for legitimate international trade operations.
          </p>
          <div class="flex items-center text-primary font-bold text-sm hover:underline cursor-pointer">
            View Credentials <Icon name="open_in_new" size="text-sm" class="ml-2" />
          </div>
        </div>
      </div>

      <!-- Trust Logos Row -->
      <div class="mt-20 border-t border-outline-variant pt-12 text-center reveal">
        <p class="text-sm font-bold text-on-surface-variant opacity-60 mb-8 uppercase tracking-[0.2em]">
          Global Accreditation Partners
        </p>
        <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24 grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-500">
          <div class="flex flex-col items-center group">
            <Icon name="rewarded_ads" size="text-5xl" class="transition-transform group-hover:scale-110" />
            <span class="text-[10px] mt-2 font-bold">KEMENDAG RI</span>
          </div>
          <div class="flex flex-col items-center group">
            <Icon name="fact_check" size="text-5xl" class="transition-transform group-hover:scale-110" />
            <span class="text-[10px] mt-2 font-bold">BPOM</span>
          </div>
          <div class="flex flex-col items-center group">
            <Icon name="health_and_safety" size="text-5xl" class="transition-transform group-hover:scale-110" />
            <span class="text-[10px] mt-2 font-bold">AR-E REGISTERED</span>
          </div>
          <div class="flex flex-col items-center group">
            <Icon name="security" size="text-5xl" class="transition-transform group-hover:scale-110" />
            <span class="text-[10px] mt-2 font-bold">EXPORT LICENSE</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-primary text-white overflow-hidden relative w-full">
    <div 
      class="absolute top-0 right-0 w-1/3 h-full bg-secondary opacity-10 -skew-x-12 translate-x-1/2 parallax-bg"
      id="cta-parallax"
    ></div>
    <div class="max-w-container-max mx-auto px-grid-gutter relative z-10 flex flex-col md:flex-row items-center justify-between">
      <div class="mb-8 md:mb-0 max-w-xl reveal">
        <h2 class="text-4xl font-bold mb-4 font-display">Ready to Partner with Indonesia's Finest?</h2>
        <p class="text-base opacity-80 leading-relaxed">
          Request our full company profile and certification documents for your procurement review.
        </p>
      </div>
      <div class="flex gap-4 reveal stagger-1">
        <Button href="/contact" variant="secondary" class="gap-2">
          Request Quote <Icon name="arrow_forward" />
        </Button>
        <Button href="/contact" variant="outline" class="border-white/30 text-white hover:bg-white/10">
          Contact Support
        </Button>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .gallery-overlay {
    background: linear-gradient(to top, rgba(1, 45, 29, 0.8) 0%, transparent 100%);
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .stagger-1 {
    transition-delay: 150ms;
  }

  .stagger-2 {
    transition-delay: 300ms;
  }

  .stagger-3 {
    transition-delay: 450ms;
  }

  .certification-card:hover .cert-icon {
    transform: scale(1.1);
    transition: transform 0.3s ease;
  }
</style>

<script>
  // Setup reveal observer
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: '0px 0px -50px 0px'
  });

  const initReveal = () => {
    document.querySelectorAll('.reveal').forEach(el => {
      revealObserver.observe(el);
    });
  };

  // Parallax scrolling triggers
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;

    // Decor bubble parallax movement
    const decorBubble = document.getElementById('decor-bubble');
    if (decorBubble) {
      decorBubble.style.transform = `translateY(${scrolled * -0.1}px)`;
    }

    // CTA Parallax background movement
    const ctaParallax = document.getElementById('cta-parallax');
    if (ctaParallax) {
      const rect = ctaParallax.parentElement!.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        const offset = (window.innerHeight - rect.top) * 0.15;
        ctaParallax.style.transform = `translateY(${offset}px) skewX(-12deg) translateX(50%)`;
      }
    }
  });

  // Initial trigger
  initReveal();
</script>
