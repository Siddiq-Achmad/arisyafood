---
import MainLayout from '../components/templates/MainLayout.astro';
import Button from '../components/atoms/Button.astro';
---

<MainLayout 
  title="Page Not Found | PT ARISYAFOOD GLOBAL NIAGA"
  description="The page you are looking for does not exist."
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-grid-gutter py-section-gap-desktop bg-surface-container-lowest relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary-container rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-secondary-container rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>

    <div class="relative z-10 max-w-2xl reveal">
      <h1 class="text-[120px] leading-none font-display font-bold text-primary mb-2 tracking-tighter">
        404
      </h1>
      <h2 class="text-headline-lg font-bold text-on-surface mb-6">
        Page Not Found
      </h2>
      <p class="text-body-lg text-on-surface-variant mb-12 leading-relaxed">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Let's get you back on track with our premium products.
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-6">
        <Button href="/" variant="primary" class="px-8 py-4">
          Return to Homepage
        </Button>
        <Button href="/products" variant="secondary" class="px-8 py-4">
          View Our Products
        </Button>
      </div>
    </div>
  </section>
</MainLayout>
