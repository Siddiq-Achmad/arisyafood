---
import MainLayout from "../components/templates/MainLayout.astro";
import Button from "../components/atoms/Button.astro";
import Icon from "../components/atoms/Icon.astro";

// Bento values dataset
const values = [
  {
    title: "Integrity",
    description:
      "Honest, transparent, and reliable in every transaction — from first contact to final delivery.",
    icon: "handshake",
    colSpan: "bg-surface-container-high text-primary",
  },
  {
    title: "Quality",
    description:
      "Zero compromise on product quality, certification standards, or food safety compliance.",
    icon: "verified",
    colSpan: "bg-secondary-container text-on-secondary-container md:col-span-2",
  },
  {
    title: "Partnership",
    description:
      "Building mutual growth between Indonesian producers, our company, and global buyers.",
    icon: "groups",
    colSpan:
      "md:col-span-3 bg-primary-container text-on-primary-container flex items-center gap-8",
  },
];

// Team dataset
const team = [
  {
    name: "Rendy",
    role: "Company Director",
    image: "/images/Team/Rendy _ Company Director.png",
  },
  {
    name: "Ryandi",
    role: "Export & Marketing Manager",
    image: "/images/Team/Ryandi _ Export & Marketing Manager_.png",
  },
  {
    name: "Dody",
    role: "Production Manager",
    image: "/images/Team/Dody _ Production Manager.png",
  },
];
// AboutPage schema for AEO
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "mainEntity": {
    "@type": "Organization",
    "name": "PT Arisyafood Global Niaga",
    "description": "An export trading company based in Medan, Indonesia, specializing in premium spices, raw crackers, and vegetarian snacks.",
    "foundingDate": "2026",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Medan",
      "addressRegion": "North Sumatra",
      "addressCountry": "Indonesia"
    }
  }
};
---

<MainLayout
  title="About Us | Top Indonesian Export Company | Arisyafood"
  description="From the fertile lands of Indonesia to tables across the globe, PT Arisyafood Global Niaga bridges the gap between traditional agricultural excellence and international quality standards."
  schemaData={[aboutSchema]}
>
  <!-- Hero Section -->
  <section
    class="relative h-[614px] min-h-[500px] flex items-center justify-center overflow-hidden w-full"
  >
    <div class="absolute inset-0 z-0">
      <img
        fetchpriority="high"
        decoding="sync"
        class="w-full h-[120%] object-cover absolute -top-[10%] parallax-bg"
        id="hero-parallax"
        alt="A panoramic high-resolution photograph of lush, emerald green Indonesian spice plantations under a soft morning mist."
        src="/images/asset_10.jpg"
      />
      <div class="absolute inset-0 bg-primary/40 mix-blend-multiply"></div>
    </div>
    <div class="relative z-10 text-center px-grid-gutter max-w-4xl">
      <h1
        class="font-display text-5xl md:text-6xl lg:text-7xl text-on-primary mb-6 font-semibold reveal-text"
      >
        Our Heritage, <br />Global Excellence
      </h1>
      <p
        class="font-body text-lg md:text-xl text-on-primary opacity-90 max-w-2xl mx-auto reveal-text"
        style="transition-delay: 200ms;"
      >
        From the fertile lands of Indonesia to tables across the globe, PT
        Arisyafood Global Niaga bridges the gap between traditional agricultural
        excellence and international quality standards.
      </p>
    </div>
  </section>

  <!-- Company Story & History -->
  <section
    class="py-section-gap-desktop max-w-container-max mx-auto px-grid-gutter w-full"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="space-y-6">
        <span
          class="text-secondary font-semibold tracking-widest uppercase reveal-text"
          >Vision & Mission</span
        >
        <h2
          class="font-headline text-3xl md:text-4xl text-primary font-semibold reveal-text"
          style="transition-delay: 100ms;"
        >
          To be Indonesia's most trusted export partner
        </h2>
        <p
          class="font-body text-on-surface-variant font-semibold reveal-text"
          style="transition-delay: 200ms;"
        >
          Vision: To be Indonesia's most trusted export partner for authentic
          snack products, recognized globally for quality, consistency, and the
          richness of Indonesian culinary heritage.
        </p>
        <ul
          class="font-body text-on-surface-variant list-disc pl-5 space-y-2 reveal-text"
          style="transition-delay: 300ms;"
        >
          <li>
            To provide premium-quality Indonesian food products with
            international standards.
          </li>
          <li>
            To build long-term partnerships with global buyers and distributors.
          </li>
          <li>To promote authentic Indonesian culinary heritage worldwide.</li>
          <li>To maintain consistency in quality, packaging, and delivery.</li>
          <li>To support sustainable growth for Indonesian food industries.</li>
        </ul>

        <!-- Experience Stats -->
        <div
          class="grid grid-cols-3 gap-4 pt-4 reveal-text"
          style="transition-delay: 400ms;"
        >
          <div class="text-center p-4 bg-surface-container rounded-xl">
            <div class="text-3xl font-semibold text-primary">15+</div>
            <div class="text-sm">Years Experience</div>
          </div>
          <div class="text-center p-4 bg-surface-container rounded-xl">
            <div class="text-3xl font-semibold text-primary">8</div>
            <div class="text-sm">Major Markets</div>
          </div>
          <div class="text-center p-4 bg-surface-container rounded-xl">
            <div class="text-3xl font-semibold text-primary">100%</div>
            <div class="text-sm">Indonesian Heritage</div>
          </div>
        </div>
      </div>

      <!-- Right Story Column -->
      <div class="relative reveal-text" style="transition-delay: 200ms;">
        <div
          class="rounded-2xl overflow-hidden shadow-xl border-4 border-white"
        >
          <img
            loading="lazy"
            decoding="async"
            class="w-full aspect-square object-cover"
            alt="A close-up, high-detail professional food photograph of various Indonesian spices."
            src="/images/asset_11.jpg"
          />
        </div>
        <div
          class="absolute -bottom-8 -right-8 bg-secondary p-8 rounded-xl text-on-secondary hidden lg:block shadow-lg max-w-sm"
        >
          <p class="font-headline text-xl italic font-semibold leading-relaxed">
            "Excellence in every grain, integrity in every shipment."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-section-gap-desktop bg-surface overflow-hidden w-full">
  </section>

  <!-- Global Footprint Stats -->
  <section
    class="bg-primary text-on-primary py-section-gap-desktop relative overflow-hidden w-full"
  >
    <div class="max-w-container-max mx-auto px-grid-gutter text-center mb-16">
      <h2
        class="font-headline text-3xl md:text-4xl mb-4 font-semibold reveal-text"
      >
        Our Global Footprint
      </h2>
      <p
        class="opacity-80 max-w-2xl mx-auto reveal-text"
        style="transition-delay: 100ms;"
      >
        We take pride in our extensive export network, delivering Indonesian
        excellence to diverse markets across Asia, the Middle East, Europe, and
        Australia.
      </p>
    </div>
    <div
      class="max-w-container-max mx-auto px-grid-gutter grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8"
    >
      <div
        class="flex flex-col items-center p-6 border border-white/10 rounded-xl hover:bg-white/5 transition-all duration-300 reveal-text"
        style="transition-delay: 200ms;"
      >
        <Icon
          name="public"
          size="text-[40px]"
          class="mb-4 text-secondary-fixed"
        />
        <h3 class="text-xl font-semibold mb-2">SE Asia</h3>
        <p class="text-sm opacity-70">Malaysia, Singapore, Brunei</p>
      </div>
      <div
        class="flex flex-col items-center p-6 border border-white/10 rounded-xl hover:bg-white/5 transition-all duration-300 reveal-text"
        style="transition-delay: 300ms;"
      >
        <Icon
          name="language"
          size="text-[40px]"
          class="mb-4 text-secondary-fixed"
        />
        <h3 class="text-xl font-semibold mb-2">East Asia</h3>
        <p class="text-sm opacity-70">Japan, Korea, China, Taiwan</p>
      </div>
      <div
        class="flex flex-col items-center p-6 border border-white/10 rounded-xl hover:bg-white/5 transition-all duration-300 reveal-text"
        style="transition-delay: 400ms;"
      >
        <Icon
          name="travel_explore"
          size="text-[40px]"
          class="mb-4 text-secondary-fixed"
        />
        <h3 class="text-xl font-semibold mb-2">Middle East</h3>
        <p class="text-sm opacity-70">UAE, Saudi Arabia, Kuwait</p>
      </div>
      <div
        class="flex flex-col items-center p-6 border border-white/10 rounded-xl hover:bg-white/5 transition-all duration-300 reveal-text"
        style="transition-delay: 450ms;"
      >
        <Icon name="map" size="text-[40px]" class="mb-4 text-secondary-fixed" />
        <h3 class="text-xl font-semibold mb-2">Europe</h3>
        <p class="text-sm opacity-70">Germany, UK, Netherlands</p>
      </div>
      <div
        class="flex flex-col items-center p-6 border border-white/10 rounded-xl hover:bg-white/5 transition-all duration-300 reveal-text"
        style="transition-delay: 500ms;"
      >
        <Icon
          name="explore"
          size="text-[40px]"
          class="mb-4 text-secondary-fixed"
        />
        <h3 class="text-xl font-semibold mb-2">Australia</h3>
        <p class="text-sm opacity-70">Direct Cargo to Key Ports</p>
      </div>
      <div
        class="flex flex-col items-center p-6 border border-white/10 rounded-xl hover:bg-white/5 transition-all duration-300 reveal-text"
        style="transition-delay: 550ms;"
      >
        <Icon
          name="flight_takeoff"
          size="text-[40px]"
          class="mb-4 text-secondary-fixed"
        />
        <h3 class="text-xl font-semibold mb-2">Logistics</h3>
        <p class="text-sm opacity-70">Global Ocean & Air Freight</p>
      </div>
    </div>
  </section>

  <!-- Core Values (Bento Layout) -->
  <section
    class="py-section-gap-desktop max-w-container-max mx-auto px-grid-gutter w-full"
  >
    <h2
      class="font-headline text-3xl md:text-4xl text-primary text-center mb-16 font-semibold reveal-text"
    >
      Our Core Values
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        values.map((val, idx) => {
          const hasIconLeft = val.icon === "eco";
          return (
            <div
              class={`p-8 rounded-3xl min-h-[300px] relative overflow-hidden group reveal-text ${val.colSpan}`}
              style={`transition-delay: ${idx * 100}ms;`}
            >
              {val.colSpan.includes("md:col-span-2") && !hasIconLeft ? (
                // Large layout (Quality Control)
                <div class="flex flex-col justify-end h-full">
                  <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-5 transition-opacity duration-500" />
                  <Icon
                    name={val.icon}
                    size="text-[48px]"
                    class="mb-4"
                    fill={true}
                  />
                  <h3 class="text-2xl font-semibold mb-2">{val.title}</h3>
                  <p class="text-on-surface-variant max-w-md">
                    {val.description}
                  </p>
                </div>
              ) : hasIconLeft ? (
                // Sustainability layout (Horizontal text + icon)
                <>
                  <div class="hidden sm:block">
                    <Icon
                      name={val.icon}
                      size="text-[60px]"
                      class="text-on-primary-container"
                    />
                  </div>
                  <div>
                    <h3 class="text-2xl font-semibold mb-2">{val.title}</h3>
                    <p class="opacity-80 leading-relaxed">{val.description}</p>
                  </div>
                </>
              ) : (
                // Small layout
                <div class="flex flex-col justify-between h-full">
                  <Icon name={val.icon} size="text-[48px]" />
                  <div>
                    <h3 class="text-2xl font-semibold mb-2">{val.title}</h3>
                    <p class="opacity-90">{val.description}</p>
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Meet Our Team -->
  <section class="bg-surface-bright py-section-gap-desktop w-full" id="team">
    <div class="max-w-container-max mx-auto px-grid-gutter">
      <div
        class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6 reveal-text"
      >
        <div class="max-w-xl">
          <span class="text-secondary font-semibold tracking-widest uppercase"
            >Our Leadership</span
          >
          <h2
            class="font-headline text-3xl md:text-4xl text-primary font-semibold mt-4"
          >
            Meet Our Team
          </h2>
          <p class="text-on-surface-variant mt-4">
            Driven by passion and expertise, our leadership team ensures that
            every product exported meets the highest global standards.
          </p>
        </div>
      </div>

      <!-- Team Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          team.map((member, index) => (
            <div
              class="rounded-2xl overflow-hidden group relative reveal-text flex flex-col bg-surface border border-outline-variant shadow-sm hover:shadow-md transition-shadow"
              style={`transition-delay: ${(index + 1) * 100}ms;`}
            >
              <div class="aspect-[3/4] overflow-hidden bg-surface-container-lowest">
                <img
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                  alt={member.name}
                  src={member.image}
                />
              </div>
              <div class="p-6 bg-white text-center">
                <h3 class="text-xl font-semibold text-primary mb-1">
                  {member.name}
                </h3>
                <p class="text-secondary text-sm font-semibold tracking-wide uppercase">
                  {member.role}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Our Export Process -->
  <section class="py-section-gap-desktop bg-surface w-full">
    <div class="max-w-container-max mx-auto px-grid-gutter">
      <div class="max-w-xl mx-auto text-center mb-16 reveal-text">
        <span class="text-secondary font-semibold tracking-widest uppercase"
          >Seamless Trade</span
        >
        <h2
          class="font-headline text-3xl md:text-4xl text-primary font-semibold mt-4"
        >
          Our Export Process
        </h2>
        <p class="text-on-surface-variant mt-4 font-body">
          We ensure a highly structured, efficient, and fully certified
          transition of premium Indonesian goods to your global port.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant rounded-3xl p-8 relative overflow-hidden group transition-all duration-300 hover:border-primary hover:shadow-lg reveal-text"
          style="transition-delay: 100ms;"
        >
          <div
            class="absolute top-6 right-8 text-4xl font-display font-extrabold text-outline-variant/30 group-hover:text-secondary/20 transition-colors duration-300"
          >
            01
          </div>
          <Icon
            name="forum"
            size="text-[48px]"
            class="text-secondary mb-6 block group-hover:scale-110 transition-transform duration-300"
          />
          <h3 class="font-headline text-xl text-primary font-semibold mb-3">
            Product Inquiry
          </h3>
          <p class="text-on-surface-variant text-sm leading-relaxed font-body">
            Submit your detailed specifications and grades. Our dedicated B2B
            trade specialists will provide a custom quote within 24 hours.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant rounded-3xl p-8 relative overflow-hidden group transition-all duration-300 hover:border-primary hover:shadow-lg reveal-text"
          style="transition-delay: 200ms;"
        >
          <div
            class="absolute top-6 right-8 text-4xl font-display font-extrabold text-outline-variant/30 group-hover:text-secondary/20 transition-colors duration-300"
          >
            02
          </div>
          <Icon
            name="agriculture"
            size="text-[48px]"
            class="text-secondary mb-6 block group-hover:scale-110 transition-transform duration-300"
          />
          <h3 class="font-headline text-xl text-primary font-semibold mb-3">
            Product Sourcing
          </h3>
          <p class="text-on-surface-variant text-sm leading-relaxed font-body">
            We partner with certified local farmer networks, utilizing advanced
            processing and rigorous quality controls to source premium goods.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant rounded-3xl p-8 relative overflow-hidden group transition-all duration-300 hover:border-primary hover:shadow-lg reveal-text"
          style="transition-delay: 300ms;"
        >
          <div
            class="absolute top-6 right-8 text-4xl font-display font-extrabold text-outline-variant/30 group-hover:text-secondary/20 transition-colors duration-300"
          >
            03
          </div>
          <Icon
            name="policy"
            size="text-[48px]"
            class="text-secondary mb-6 block group-hover:scale-110 transition-transform duration-300"
          />
          <h3 class="font-headline text-xl text-primary font-semibold mb-3">
            Export Handling
          </h3>
          <p class="text-on-surface-variant text-sm leading-relaxed font-body">
            Our trade experts oversee phytosanitary checks, customs clearance,
            and all mandatory global B2B trade documentation.
          </p>
        </div>

        <!-- Step 4 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant rounded-3xl p-8 relative overflow-hidden group transition-all duration-300 hover:border-primary hover:shadow-lg reveal-text"
          style="transition-delay: 400ms;"
        >
          <div
            class="absolute top-6 right-8 text-4xl font-display font-extrabold text-outline-variant/30 group-hover:text-secondary/20 transition-colors duration-300"
          >
            04
          </div>
          <Icon
            name="sailing"
            size="text-[48px]"
            class="text-secondary mb-6 block group-hover:scale-110 transition-transform duration-300"
          />
          <h3 class="font-headline text-xl text-primary font-semibold mb-3">
            Global Delivery
          </h3>
          <p class="text-on-surface-variant text-sm leading-relaxed font-body">
            Cargo is carefully sealed in food-grade cargo containers, dispatched
            via premium ocean or air logistics, and tracked in real-time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner CTA Section -->
  <section class="py-section-gap-desktop bg-surface overflow-hidden w-full">
    <div
      class="max-w-container-max mx-auto px-grid-gutter text-center bg-primary p-16 rounded-[40px] relative overflow-hidden reveal-text"
    >
      <div class="absolute inset-0 opacity-10">
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"
        >
        </div>
      </div>

      <!-- Parallax Pattern Overlay -->
      <div
        class="absolute inset-0 opacity-5 parallax-bg pointer-events-none"
        id="cta-pattern"
        style="background-image: radial-gradient(circle, white 2px, transparent 0); background-size: 40px 40px;"
      >
      </div>

      <div class="relative z-10">
        <h2
          class="font-display text-4xl md:text-5xl text-on-primary mb-8 font-semibold"
        >
          Ready to Partner with Indonesia's Best?
        </h2>
        <p class="text-lg text-on-primary opacity-80 max-w-xl mx-auto mb-10">
          Join our global network of distributors and retailers. Experience the
          premium taste and reliable service of PT Arisyafood Global Niaga.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button
            href="/contact"
            variant="secondary"
            class="px-10 py-4 text-lg"
          >
            Request Wholesale Quote
          </Button>
          <Button
            href="#"
            variant="outline"
            class="border-2 border-white/30 text-white hover:bg-white/10 text-lg px-10 py-4"
          >
            Download Catalog
          </Button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .reveal-text {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.21, 0.45, 0.32, 0.9);
  }

  .reveal-text.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  (() => {
    // Setup reveal observer
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -50px 0px",
      },
    );

    const initReveal = () => {
      document.querySelectorAll(".reveal-text").forEach((el) => {
        revealObserver.observe(el);
      });
    };

    // Parallax scrolling triggers
    window.addEventListener("scroll", () => {
      // CTA Pattern parallax movement
      const ctaPattern = document.getElementById("cta-pattern");
      if (ctaPattern) {
        const rect = ctaPattern.parentElement!.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          const offset = (window.innerHeight - rect.top) * 0.1;
          ctaPattern.style.transform = `translateY(${offset}px)`;
        }
      }
    });

    // Initial trigger
    initReveal();
  })();
</script>
